<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="timespan"
        Arguments=""
        InstallLocation="C:\Program Files\SergeiPro\TimeSpan">
    </Installer>
    <PackageInformation
        PackageName="TimeSpan"
        PackageDisplayName="TimeSpan"
        PublisherName="CN=SergeiPro"
        PublisherDisplayName="SergeiPro"
        Version="0.0.1.0"
        PackageDescription="A task timings management app">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.timespan.app"
                Description="A task timings management app"
                DisplayName="TimeSpan"
                ExecutableName="timespan"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>TimeSpan</DisplayName>
            <PublisherDisplayName>SergeiPro</PublisherDisplayName>
            <Description>A task timings management app</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="timespan.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
